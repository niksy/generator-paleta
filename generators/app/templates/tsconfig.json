{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"moduleDetection": "force",
		"target": "<%= tsConfigTargets.target %>",
		"lib": [<% if ( browserModule ) { %>
			"DOM",<% } %>
			"<%= tsConfigTargets.lib %>"
		],
		"resolveJsonModule": false,
		"newLine": "lf",
		"strict": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,
		"noEmit": true,
		"noEmitOnError": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"allowJs": true<% if ( typescript ) { %>,
		"checkJs": true<% } %>,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true<% if ( automatedTests && !browserModule && typescriptMode === 'full' ) { %>,
		"inlineSourceMap": true<% } %>
	},
	"include": ["*<% if ( extensionsToProcess.length > 1 ) { %>.{<%- extensionsToProcess.join(',') %>}<% } else { %>.js<% } %>", "lib", "test"]
}
